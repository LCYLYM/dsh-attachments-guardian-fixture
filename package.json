{
  "name": "dsh-multimedia-webui-input",
  "version": "0.1.0",
  "private": true,
  "description": "Public fixture for testing automated DSH plugin compatibility maintenance",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LCYLYM/dsh-attachments-guardian-fixture.git"
  },
  "bugs": {
    "url": "https://github.com/LCYLYM/dsh-attachments-guardian-fixture/issues"
  },
  "homepage": "https://github.com/LCYLYM/dsh-attachments-guardian-fixture#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-input-trigger",
      "@deepseek-ai/dsh-client-ui-conversation",
      "@deepseek-ai/dsh-client-ui-settings"
    ],
    "platform": "web"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "scripts",
    "install.sh",
    "install.ps1",
    "docs",
    "promo/assets/dsh-multimedia-webui-input-demo.gif",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT"
}
